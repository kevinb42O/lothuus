# Vercel: server-only environment variables (never NEXT_PUBLIC_*).
BACKEND_MODE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-key
ADMIN_USER_ID=your-confirmed-owner-uuid
ADMIN_EMAIL=katrien@lothuus.be
# Exact production browser origin; set after connecting Vercel/domain.
# APP_ORIGIN=https://www.lothuus.be

# Private Cloudflare R2, accessed from the Vercel Node.js server using S3.
R2_BUCKET=lothuus-media
R2_ENDPOINT=https://your-account.eu.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-bucket-scoped-key
R2_SECRET_ACCESS_KEY=your-bucket-scoped-secret

# Local development only: optional existing Wrangler OAuth access.
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# R2_USE_WRANGLER=true

# Isolated SQLite development tests only; not a production fallback.
# LOTHUUS_DATA_DIR=/absolute/path/to/test-data
# ADMIN_PASSWORD=unique-local-test-password
TRUST_PROXY=false

# Hosting usage: account-scoped Account Analytics Read token, server only.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_ANALYTICS_TOKEN=your-account-analytics-read-token
# Vercel sends this as Bearer authorization to the daily hosting cron.
CRON_SECRET=your-random-server-only-cron-secret

# Cookieless visit collection. Public build flag; never contains credentials.
# Defaults to enabled in production and disabled in development. False disables it.
# Apply the analytics migration before the first production build with tracking.
# NEXT_PUBLIC_VISITOR_TRACKING=false

# Daily verified cloud backups; the credential must have access to this private bucket.
# Reuses the existing R2 credential only if it already has backup-bucket access.
R2_BACKUP_BUCKET=lothuus-backups
# R2_BACKUP_ACCESS_KEY_ID=existing-backup-bucket-key
# R2_BACKUP_SECRET_ACCESS_KEY=existing-backup-bucket-secret

# Read-only provider usage connection (analytics_usage_read + billing_read).
# Never use the database service key here. Missing access is shown as unavailable, not zero.
# SUPABASE_USAGE_TOKEN=your-existing-read-only-management-token
SUPABASE_EGRESS_LIMIT_BYTES=5000000000
